---
const servicios = [
  {
    titulo: 'Instalamos y medimos',
    texto:
      'Abrimos la cuenta publicitaria, instalamos los códigos de medición y dejamos definido por escrito qué cuenta como venta.',
    icono: 'M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8M12 22v-5M9 8V2M15 8V2',
  },
  {
    titulo: 'Operamos cada semana',
    texto:
      'Cargamos anuncios y probamos situaciones distintas. Lo que no trae ventas, se corta.',
    icono:
      'M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5',
  },
  {
    titulo: 'Reporte los viernes',
    texto:
      'Una página, sin jerga: gasto, ventas y costo por venta de la semana.',
    icono:
      'M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7ZM14 2v5h5M16 13H8M16 17H8M10 9H8',
  },
  {
    titulo: 'Cortamos si no funciona',
    texto:
      'La meta de costo por venta se acuerda por escrito antes de partir. Si el piloto no la alcanza, se corta.',
    icono: 'M4.9 4.9l14.2 14.2',
    circulo: true,
  },
];
---

<section class="section servicio">
  <div class="container">
    <div class="section-head">
      <h2>Qué hacemos</h2>
      <p>
        Cuatro piezas que dejan el canal corriendo, todas incluidas en el
        piloto.
      </p>
    </div>

    <div class="grid">
      {
        servicios.map((s) => (
          <article class="card item">
            <span class="icono" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {s.circulo && <circle cx="12" cy="12" r="10" />}
                <path d={s.icono} />
              </svg>
            </span>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
  }

  .item h3 {
    font-size: 1.125rem;
    margin-top: var(--space-3);
  }

  .item p {
    margin-top: var(--space-2);
    color: var(--color-muted-foreground);
  }

  .icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--color-muted);
    color: var(--color-primary);
  }

  .icono svg {
    width: 22px;
    height: 22px;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
